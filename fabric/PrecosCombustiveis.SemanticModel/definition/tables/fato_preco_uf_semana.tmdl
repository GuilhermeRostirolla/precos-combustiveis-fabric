table fato_preco_uf_semana
	lineageTag: f899bf34-d222-5a11-8d1c-679b46b086f4
	sourceLineageTag: [gold].[fato_preco_uf_semana]

	measure 'Preço Bomba RS' = CALCULATE ( AVERAGE ( fato_preco_uf_semana[preco_medio] ), fato_preco_uf_semana[uf] = "RS" )
		formatString: """R$"" #,0.000"
		displayFolder: Preços
		lineageTag: 6fc0eadf-1f4e-571e-bc4b-b1deb889a270

	measure 'Preço Bomba Brasil' = ```
			VAR postos = SUMX ( fato_preco_uf_semana, fato_preco_uf_semana[coletas] )
			RETURN
			    DIVIDE ( SUMX ( fato_preco_uf_semana, fato_preco_uf_semana[preco_medio] * fato_preco_uf_semana[coletas] ), postos )
			```
		formatString: """R$"" #,0.000"
		displayFolder: Preços
		lineageTag: b5d12dfe-233f-517f-8653-b0985abea875

	measure 'Postos Pesquisados RS' = CALCULATE ( SUM ( fato_preco_uf_semana[postos] ), fato_preco_uf_semana[uf] = "RS" )
		formatString: #,0
		displayFolder: Preços
		lineageTag: cafc9e43-9c6c-5d65-a17c-e9f8ae7e6840

	measure 'Preço Bomba RS Última Semana' = ```
			VAR ultima =
			    CALCULATE ( MAX ( fato_preco_uf_semana[semana] ), fato_preco_uf_semana[uf] = "RS", REMOVEFILTERS ( dim_semana ) )
			RETURN
			    CALCULATE ( [Preço Bomba RS], fato_preco_uf_semana[semana] = ultima, REMOVEFILTERS ( dim_semana ) )
			```
		formatString: """R$"" #,0.000"
		displayFolder: Preços
		lineageTag: 92cee4e2-0297-5987-86d3-4819e833d049

	measure 'Semana Mais Recente' = CALCULATE ( MAX ( fato_preco_uf_semana[semana] ), fato_preco_uf_semana[uf] = "RS", REMOVEFILTERS ( dim_semana ) )
		formatString: dd/MM/yyyy
		displayFolder: Preços
		lineageTag: 8ee3f0ff-fc06-5134-a8ec-656bd36e2746

	measure 'Texto Dados Até' = "Postos pesquisados até a semana de " & FORMAT ( [Semana Mais Recente], "dd/MM/yyyy" )
		displayFolder: Preços
		lineageTag: 4566e258-9049-5dd3-baba-9aef4fbd5784

