		summarizeBy: none
		sourceColumn: semana

		annotation SummarizationSetBy = Automatic

	column preco_produtor
		dataType: decimal
		formatString: """R$"" #,0.0000"
		lineageTag: ea68d3d2-c93d-5840-b757-e4142f568ca3
		sourceLineageTag: preco_produtor
		summarizeBy: none
		sourceColumn: preco_produtor

		annotation SummarizationSetBy = Automatic

	column fracao_fossil
		dataType: decimal
