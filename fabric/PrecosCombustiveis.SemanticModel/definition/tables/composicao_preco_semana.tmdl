	measure 'Refinaria no Mês' = ```
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR ref = [Semana de Referência]
			VAR inicio = DATE ( YEAR ( ref ), MONTH ( ref ) - 11, 1 )
			VAR m = MAX ( dim_semana[mes_inicio] )
			RETURN
			    IF (
			        m >= inicio && m <= ref,
			        CALCULATE ( AVERAGE ( composicao_preco_semana[refinaria] ), REMOVEFILTERS ( dim_uf ), composicao_preco_semana[uf] = u, composicao_preco_semana[semana] <= ref )
			    )
			```
		formatString: """R$"" #,0.00"
		displayFolder: Gráfico
		lineageTag: 765fe8a6-234d-5905-8497-b539479adba9

