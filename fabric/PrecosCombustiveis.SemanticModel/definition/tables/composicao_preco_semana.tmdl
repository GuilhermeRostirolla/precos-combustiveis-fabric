	measure 'Apoio Impostos' = FORMAT ( DIVIDE ( [Impostos no Litro], [Preço no Posto] ), "0%" ) & " do preço · ICMS R$ " & FORMAT ( [ICMS no Litro], "0.00" )
		displayFolder: Visão geral
		lineageTag: bee13de0-9060-5dd1-b4cf-252c489f16de

	measure 'Apoio Refinaria 4 Semanas' = ```
			VAR d = [Preço no Posto] - [Preço no Posto 4 Semanas Antes]
			RETURN
			    "No posto: " & IF ( d > 0.005, "▲ ", IF ( d < -0.005, "▼ ", "= " ) ) & "R$ " & FORMAT ( ABS ( d ), "0.00" ) & " no mesmo período"
			```
		displayFolder: Visão geral
