	measure 'Preço Etanol' = ```
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR s = [Semana de Referência]
			RETURN
			    CALCULATE (
			        DIVIDE (
			            SUMX ( fato_preco_uf_semana, fato_preco_uf_semana[preco_medio] * fato_preco_uf_semana[coletas] ),
			            SUM ( fato_preco_uf_semana[coletas] )
			        ),
			        REMOVEFILTERS ( dim_semana ),
			        REMOVEFILTERS ( dim_uf ),
			        dim_produto[produto] = "ETANOL",
			        fato_preco_uf_semana[semana] = s,
			        FILTER ( ALL ( fato_preco_uf_semana[uf] ), u = "BR" || fato_preco_uf_semana[uf] = u )
			    )
			```
		formatString: """R$"" #,0.00"
		displayFolder: Visão geral
		lineageTag: 97725de7-970c-5044-b066-c3de12faf938

	measure 'Preço Gasolina' = ```
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR s = [Semana de Referência]
			RETURN
			    CALCULATE (
			        DIVIDE (
			            SUMX ( fato_preco_uf_semana, fato_preco_uf_semana[preco_medio] * fato_preco_uf_semana[coletas] ),
			            SUM ( fato_preco_uf_semana[coletas] )
			        ),
			        REMOVEFILTERS ( dim_semana ),
			        REMOVEFILTERS ( dim_uf ),
			        dim_produto[produto] = "GASOLINA",
			        fato_preco_uf_semana[semana] = s,
			        FILTER ( ALL ( fato_preco_uf_semana[uf] ), u = "BR" || fato_preco_uf_semana[uf] = u )
			    )
			```
		formatString: """R$"" #,0.00"
		displayFolder: Visão geral
		lineageTag: 63894154-2e69-5129-a267-de9f58f77a93

	measure 'Etanol ÷ Gasolina' = DIVIDE ( [Preço Etanol], [Preço Gasolina] )
		formatString: 0%
		displayFolder: Visão geral
		lineageTag: e87843ad-5b7c-5890-a628-54d1c5b7c7d9

	measure 'Apoio Preço no Posto' = ```
			VAR d = [Preço no Posto] - [Preço no Posto Semana Anterior]
			RETURN
			    IF ( NOT ISBLANK ( [Preço no Posto Semana Anterior] ), IF ( d > 0.005, "▲ ", IF ( d < -0.005, "▼ ", "= " ) ) & "R$ " & FORMAT ( ABS ( d ), "0.00" ) & " vs semana anterior" )
			```
		displayFolder: Visão geral
		lineageTag: 2ee193ba-9f48-559b-bef0-5f94a352943e

	measure 'Apoio Variação 12 Meses' = "Refinaria no mesmo período: " & FORMAT ( [Variação 12 Meses Refinaria], "+0.0%;-0.0%" )
		displayFolder: Visão geral
