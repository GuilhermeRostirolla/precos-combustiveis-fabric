	measure 'Refinaria por Litro' = ```
			// produtores e importadores, sem tributos, por litro de gasolina A ou diesel A
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR s = [Semana de Referência] - 0
			RETURN
			    CALCULATE (
			        AVERAGEX ( composicao_preco_semana, composicao_preco_semana[refinaria] / composicao_preco_semana[fracao_fossil] ),
			        REMOVEFILTERS ( dim_semana ),
			        REMOVEFILTERS ( dim_uf ),
			        composicao_preco_semana[uf] = u,
			        composicao_preco_semana[semana] = s
			    )
			```
		formatString: """R$"" #,0.00"
		displayFolder: Visão geral
		lineageTag: 7e20977a-dfe8-59f0-8124-bb83ddd68244

