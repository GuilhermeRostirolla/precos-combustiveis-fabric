	measure 'Outros Mês Anterior' = ```
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR ref = [Semana de Referência]
			VAR m = EDATE ( [Mês Explicado], -1 )
			RETURN
			    CALCULATE (
			        AVERAGE ( composicao_preco_semana[outros] ),
			        REMOVEFILTERS ( dim_semana ),
			        REMOVEFILTERS ( dim_uf ),
			        composicao_preco_semana[uf] = u,
