	measure 'Outros Mês Explicado' = ```
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR ref = [Semana de Referência]
			VAR m = [Mês Explicado]
			RETURN
			    CALCULATE (
			        AVERAGE ( composicao_preco_semana[outros] ),
			        REMOVEFILTERS ( dim_semana ),
			        REMOVEFILTERS ( dim_uf ),
			        composicao_preco_semana[uf] = u,
			        composicao_preco_semana[semana] >= m,
			        composicao_preco_semana[semana] <= EOMONTH ( m, 0 ),
			        composicao_preco_semana[semana] <= ref
			    )
			```
		formatString: """R$"" #,0.00"
