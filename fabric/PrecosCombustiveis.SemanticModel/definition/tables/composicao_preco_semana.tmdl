	measure 'Conclusão' = ```
			VAR d = [Δ Posto]
			VAR s = IF ( d < 0, -1, 1 )
			VAR r = [Δ Refinaria] * s
			VAR i = [Δ Impostos] * s
			VAR o = [Δ Outros] * s
			VAR maior =
			    SWITCH (
			        TRUE (),
			        r >= i && r >= o, "da refinaria",
			        i >= o, "dos impostos",
			        "do etanol/biodiesel, do frete e das margens"
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( d ), BLANK (),
			        ABS ( d ) < 0.02, "O preço no posto ficou praticamente estável.",
			        IF ( d > 0, "A alta", "A queda" ) & " veio principalmente " & maior & "."
			    )
			```
		displayFolder: Por que mudou
		lineageTag: 66dc4de8-d4eb-5e4c-a336-1c81efaa5ed6

	measure 'Conclusão Detalhe' = ```
			VAR p = SELECTEDVALUE ( dim_produto[produto], "GASOLINA" )
			VAR m = [Mês Explicado]
			VAR eventos =
			    CONCATENATEX (
			        FILTER (
			            evento,
			            evento[data] >= m && evento[data] <= EOMONTH ( m, 0 )
			                && ( evento[produto] = p || evento[produto] = "TODOS" )
			        ),
			        evento[descricao],
			        ". ",
			        evento[data], ASC
			    )
			VAR partes =
			    "Refinaria " & IF ( [Δ Refinaria] < 0, "-", "+" ) & "R$ " & FORMAT ( ABS ( [Δ Refinaria] ), "0.00" ) & ", impostos " & IF ( [Δ Impostos] < 0, "-", "+" ) & "R$ " & FORMAT ( ABS ( [Δ Impostos] ), "0.00" )
			        & " e etanol/biodiesel, frete e margens " & IF ( [Δ Outros] < 0, "-", "+" ) & "R$ " & FORMAT ( ABS ( [Δ Outros] ), "0.00" ) & " por litro."
			RETURN
			    IF (
			        ISBLANK ( [Δ Posto] ),
			        BLANK (),
			        IF ( eventos <> "", eventos & ". " & partes, partes )
			    )
			```
		displayFolder: Por que mudou
		lineageTag: 53baac29-95a6-5e05-8d84-6c4afbabc950

