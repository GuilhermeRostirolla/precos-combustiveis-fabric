	measure 'Variação 12 Meses Posto' = ```
			VAR a = [Preço no Posto]
			VAR b = [Preço no Posto 12 Meses Antes]
			RETURN
			    IF ( NOT ISBLANK ( a ) && NOT ISBLANK ( b ), a / b - 1 )
			```
