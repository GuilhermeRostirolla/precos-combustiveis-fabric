table composicao_preco_semana
	lineageTag: e57a8d83-c747-5ec8-b7f3-dd349698563a
	sourceLineageTag: [gold].[composicao_preco_semana]

	measure 'Semana de Referência' = ```
			VAR s = SELECTEDVALUE ( semana_referencia[semana] )
			RETURN
			    IF ( ISBLANK ( s ), CALCULATE ( MAX ( composicao_preco_semana[semana] ), REMOVEFILTERS () ), s )
			```
		formatString: dd/MM/yyyy
		displayFolder: Visão geral
		lineageTag: b8163186-9727-536e-af61-d534e615eddb

	measure 'Texto Semana de Referência' = "Dados até a semana de " & FORMAT ( [Semana de Referência], "dd/MM/yyyy" ) & " · Fonte: ANP"
		displayFolder: Visão geral
		lineageTag: 17b79340-066d-5b66-8f34-a237fceaceb7

	measure 'Preço no Posto' = ```
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR s = [Semana de Referência] - 0
			RETURN
			    CALCULATE (
			        AVERAGE ( composicao_preco_semana[preco_posto] ),
			        REMOVEFILTERS ( dim_semana ),
			        REMOVEFILTERS ( dim_uf ),
			        composicao_preco_semana[uf] = u,
			        composicao_preco_semana[semana] = s
			    )
			```
		formatString: """R$"" #,0.00"
		displayFolder: Visão geral
		lineageTag: a25546cd-8719-5c39-8905-cd0cfe059bf2

	measure 'Preço no Posto Semana Anterior' = ```
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR s = [Semana de Referência] - 7
			RETURN
