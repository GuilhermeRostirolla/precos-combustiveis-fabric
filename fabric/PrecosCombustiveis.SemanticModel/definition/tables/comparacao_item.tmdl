	measure 'Aumentos ÷ Reduções' = ```
			VAR a = [Repasse dos Aumentos em 2 Semanas]
			VAR b = [Repasse das Reduções em 2 Semanas]
			RETURN
			    IF ( b > 0.05, a / b )
			```
		formatString: "0.0""×"""
		displayFolder: Repasse
		lineageTag: c9d7b0bb-22de-5349-9294-38ae92fc4d7b

	measure 'Texto Aumentos ÷ Reduções' = IF ( ISBLANK ( [Aumentos ÷ Reduções] ), "", "repasse dos aumentos ÷ repasse das reduções" )
