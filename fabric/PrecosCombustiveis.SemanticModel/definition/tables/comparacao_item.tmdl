	measure 'Repasse dos Aumentos na Região' = ```
			VAR escolha = SELECTEDVALUE ( comparacao_item[item] )
			VAR tipo = SELECTEDVALUE ( comparacao_item[tipo] )
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR e =
			    SWITCH ( TRUE (),
			        tipo = "Região", "Região " & escolha,
			        escolha = u, escolha & " (estado)" )
			RETURN
			    IF ( NOT ISBLANK ( e ),
			        CALCULATE ( MAX ( repasse_resumo[repasse_ponderado] ), REMOVEFILTERS ( dim_uf ),
			            repasse_resumo[escopo] = e, repasse_resumo[direcao] = "alta", repasse_resumo[h] = 2 ) )
			```
		formatString: 0%
		displayFolder: Repasse
		lineageTag: db7219d9-3933-517c-ad4e-ac97e9e33469

