	measure 'Refinaria Explicaria' = ```
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR e = IF ( u = "BR", "Brasil", u & " (estado)" )
			RETURN
			    CALCULATE (
			        AVERAGE ( repasse_curva[repasse_esperado] ),
			        REMOVEFILTERS ( dim_uf ),
			        repasse_curva[h] = 2,
			        KEEPFILTERS ( repasse_curva[semana_evento] >= DATE ( 2025, 1, 1 ) ),
			        ISBLANK ( repasse_curva[municipio] ),
			        FILTER ( ALL ( repasse_curva[escopo] ), e = "Brasil" || repasse_curva[escopo] = e )
			    )
			```
		formatString: "+""R$"" 0.00;-""R$"" 0.00;""R$"" 0.00"
		displayFolder: Repasse
		lineageTag: a40db633-5785-5444-9928-c735e8d73ee8

	measure 'Chegou ao Posto em 2 Semanas' = ```
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR e = IF ( u = "BR", "Brasil", u & " (estado)" )
			RETURN
			    CALCULATE (
			        AVERAGE ( repasse_curva[variacao_bomba] ),
			        REMOVEFILTERS ( dim_uf ),
			        repasse_curva[h] = 2,
			        KEEPFILTERS ( repasse_curva[semana_evento] >= DATE ( 2025, 1, 1 ) ),
			        ISBLANK ( repasse_curva[municipio] ),
			        FILTER ( ALL ( repasse_curva[escopo] ), e = "Brasil" || repasse_curva[escopo] = e )
			    )
			```
		formatString: "+""R$"" 0.00;-""R$"" 0.00;""R$"" 0.00"
		displayFolder: Repasse
		lineageTag: 4526a5ab-62af-5f84-a599-4e0d8da3b4af

	measure 'Cor Chegou ao Posto' = ```
			VAR d = [Refinaria Explicaria]
			RETURN
			    IF ( NOT ISBLANK ( d ), IF ( d > 0, "#E5534B", "#3FB950" ) )
			```
		displayFolder: Cores
		lineageTag: 8d407e9e-35a7-58d3-9047-c890b4417559

