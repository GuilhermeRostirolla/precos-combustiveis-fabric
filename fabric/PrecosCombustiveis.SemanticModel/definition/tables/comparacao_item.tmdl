		lineageTag: 211dd980-9d05-56b0-91dd-941bf34c38c3

	measure 'Assimetria do Repasse' = ```
			VAR a = [Repasse Alta 2 Semanas]
			VAR b = [Repasse Baixa 2 Semanas]
			RETURN
			    IF ( b > 0.05, a / b )
			```
		formatString: "0.0""×"""
		displayFolder: Repasse
		lineageTag: 9cf383d0-6610-5936-b2c6-605c8542ad96

	measure 'Texto Assimetria' = IF ( ISBLANK ( [Assimetria do Repasse] ), "", "a alta chega " & FORMAT ( [Assimetria do Repasse], "0.0" ) & " vezes mais" )
		displayFolder: Repasse
		lineageTag: 18f116cb-fe2b-5bb7-81e9-5a16a48c0384

	measure 'Curva Alta' = ```
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
