table comparacao_item
	lineageTag: b45cf0c8-b36b-5c3d-833d-260937fcbbb6
	sourceLineageTag: [gold].[comparacao_item]

	measure 'Reajustes no Escopo' = ```
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR e = IF ( u = "BR", "Brasil", u & " (estado)" )
			RETURN
			    COUNTROWS (
			        SUMMARIZE (
			            CALCULATETABLE (
			                FILTER ( repasse_curva, repasse_curva[h] = 0 && ISBLANK ( repasse_curva[municipio] )
			                    && ( e = "Brasil" || repasse_curva[escopo] = e ) ),
			                REMOVEFILTERS ( dim_uf )
			            ),
			            repasse_curva[regiao], repasse_curva[semana_evento]
			        )
			    )
			```
		formatString: #,0
		displayFolder: Repasse
		lineageTag: 21cdc36f-6c37-5029-abbd-7b7b37876419

	measure 'Texto Altas e Baixas' = FORMAT ( [Altas no Escopo], "0" ) & " altas · " & FORMAT ( [Baixas no Escopo], "0" ) & " baixas"
		displayFolder: Repasse
		lineageTag: d821dbf8-68ae-5de6-9ecc-dd4ae2294955

	measure 'Altas no Escopo' = ```
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR e = IF ( u = "BR", "Brasil", u & " (estado)" )
			RETURN
			    COUNTROWS (
			        SUMMARIZE (
			            CALCULATETABLE (
			                FILTER ( repasse_curva, repasse_curva[h] = 0 && ISBLANK ( repasse_curva[municipio] )
			                    && ( e = "Brasil" || repasse_curva[escopo] = e ) && repasse_curva[direcao] = "alta" ),
			                REMOVEFILTERS ( dim_uf )
			            ),
			            repasse_curva[regiao], repasse_curva[semana_evento]
			        )
			    )
			```
		formatString: #,0
		displayFolder: Repasse
		lineageTag: 274778c2-95cd-5e9e-9836-f290904eb0f7

	measure 'Baixas no Escopo' = ```
