	measure 'Repasse dos Aumentos em 2 Semanas' = ```
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR e = IF ( u = "BR", "Brasil", u & " (estado)" )
			RETURN
			    CALCULATE ( MAX ( repasse_resumo[repasse_ponderado] ), REMOVEFILTERS ( dim_uf ),
			        repasse_resumo[escopo] = e, repasse_resumo[direcao] = "alta", repasse_resumo[h] = 2 )
			```
		formatString: 0%
		displayFolder: Repasse
		lineageTag: 8c627191-185d-501e-9ffa-de2e1a4ea513

