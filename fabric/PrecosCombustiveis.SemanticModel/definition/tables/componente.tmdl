	measure 'Legenda Δ12 Refinaria' = ```
			VAR d = [Δ12 Refinaria]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( d ), "",
			        [Principal Motivo 12 Meses] = "Refinaria" && ABS ( [Δ12 Posto] ) >= 0.02, "▲ principal motivo",
			        d >= 0.01, "subiu",
			        d <= -0.01, "caiu",
			        "ficou estável"
			    )
			```
		displayFolder: Ponte
		lineageTag: da43fcdd-2aef-5038-b0c7-3fc9689177a5

