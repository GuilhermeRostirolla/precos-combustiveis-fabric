	measure 'Impostos 12 Meses Antes' = ```
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR s = [Semana de Referência] - 364
			RETURN
			    CALCULATE (
			        AVERAGE ( composicao_preco_semana[tributos_federais] ) + AVERAGE ( composicao_preco_semana[icms] ),
			        REMOVEFILTERS ( dim_semana ),
			        REMOVEFILTERS ( dim_uf ),
			        composicao_preco_semana[uf] = u,
			        composicao_preco_semana[semana] = s
			    )
			```
