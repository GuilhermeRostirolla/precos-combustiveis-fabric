	measure 'Cor Δ12 Refinaria' = ```
			VAR d = [Δ12 Refinaria]
			RETURN
			    IF ( d >= 0.01, "#E5534B", IF ( d <= -0.01, "#3FB950", "#8B95A9" ) )
			```
