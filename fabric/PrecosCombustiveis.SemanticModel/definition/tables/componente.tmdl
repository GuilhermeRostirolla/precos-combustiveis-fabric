	measure 'Preço por Região' = ```
			// média dos postos pesquisados nos estados da região (ou do Brasil), na semana de referência
			VAR r = SELECTEDVALUE ( regiao_comparacao[regiao] )
			VAR s = [Semana de Referência]
			VAR atuais = VALUES ( regiao_comparacao[uf] )
			VAR ufs = FILTER ( ALL ( regiao_comparacao[uf] ), r = "Brasil" || regiao_comparacao[uf] IN atuais )
			RETURN
			    CALCULATE (
			        DIVIDE (
			            SUMX ( fato_preco_uf_semana, fato_preco_uf_semana[preco_medio] * fato_preco_uf_semana[coletas] ),
			            SUM ( fato_preco_uf_semana[coletas] )
			        ),
			        REMOVEFILTERS ( dim_semana ),
			        REMOVEFILTERS ( dim_uf ),
			        TREATAS ( ufs, fato_preco_uf_semana[uf] ),
			        fato_preco_uf_semana[semana] = s
			    )
			```
		formatString: #,0.00
		displayFolder: Gráfico
		lineageTag: 834694ab-8385-583a-9986-efb11d5f493f

	measure 'Cor da Região' = ```
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR escolhida = IF ( u = "BR", "Brasil", LOOKUPVALUE ( regiao_comparacao[regiao], regiao_comparacao[uf], u ) )
			VAR r = SELECTEDVALUE ( regiao_comparacao[regiao] )
			RETURN
			    IF ( r = escolhida, "#E8833A", IF ( r = "Brasil", "#8B95A9", "#3A4660" ) )
			```
		displayFolder: Cores
		lineageTag: eaaf881e-496b-56af-90e0-2c6ce992f381

