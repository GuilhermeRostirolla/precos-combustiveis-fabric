	measure 'Variação 12 Meses do Componente' = ```
			SWITCH (
			    SELECTEDVALUE ( componente[componente] ),
			    "Refinaria", [Δ12 Refinaria],
			    "Impostos", [Δ12 Impostos],
			    [Δ12 Outros]
			)
