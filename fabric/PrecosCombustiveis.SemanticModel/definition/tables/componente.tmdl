table componente
	lineageTag: bf49bf38-cc4a-5ef8-a0b3-83168b6e86f5
	sourceLineageTag: [gold].[componente]

	measure 'Principal Motivo 12 Meses' = ```
			VAR d = [Δ12 Posto]
			VAR s = IF ( d < 0, -1, 1 )
			VAR r = [Δ12 Refinaria] * s
			VAR i = [Δ12 Impostos] * s
			VAR o = [Δ12 Outros] * s
			RETURN
			    SWITCH ( TRUE (), o >= r && o >= i, "Outros", r >= i, "Refinaria", "Impostos" )
			```
		displayFolder: Ponte
		lineageTag: eba9b91c-9ef5-5ff0-846e-74ed29d0da61

	measure 'Manchete 12 Meses' = ```
			VAR d = [Δ12 Posto]
			VAR r = [Δ12 Refinaria]
			VAR m = [Principal Motivo 12 Meses]
			VAR motivo = SWITCH ( m, "Refinaria", "da refinaria", "Impostos", "dos impostos", "de etanol, frete e margens" )
			VAR refinaria =
			    SWITCH ( TRUE (), r <= -0.01, "A refinaria baixou R$ " & FORMAT ( -r, "0.00" ),
			        r >= 0.01, "A refinaria subiu R$ " & FORMAT ( r, "0.00" ), "A refinaria ficou estável" )
			RETURN
			    IF (
			        ISBLANK ( d ),
			        "",
			        [Conclusão 12 Meses] & " " & refinaria & "; "
			            & IF ( d >= 0, "o aumento", "a queda" ) & " veio principalmente " & motivo & "."
			    )
			```
		displayFolder: Ponte
		lineageTag: 59076442-686c-56d6-bf39-a3a673f4f626

	measure 'Texto Preço 12 Meses Antes' = IF ( ISBLANK ( [Ponte Posto 12 Meses Antes] ), "", "R$ " & FORMAT ( [Ponte Posto 12 Meses Antes], "0.00" ) )
		displayFolder: Ponte
		lineageTag: b4f87556-f2e5-5b74-8176-74a887b4ed71

	measure 'Texto Preço Hoje' = IF ( ISBLANK ( [Ponte Posto Hoje] ), "", "R$ " & FORMAT ( [Ponte Posto Hoje], "0.00" ) )
		displayFolder: Ponte
		lineageTag: 70a578f9-7d88-5aba-bdff-9f240a636f7d

