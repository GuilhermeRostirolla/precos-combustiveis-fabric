	measure 'Refinaria na Semana' = ```
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR ref = [Semana de Referência]
			VAR s = MAX ( dim_semana[semana] )
			RETURN
			    IF ( s > ref - 364 && s <= ref, CALCULATE ( AVERAGE ( composicao_preco_semana[refinaria] ), REMOVEFILTERS ( dim_uf ), composicao_preco_semana[uf] = u ) )
			```
		formatString: """R$"" #,0.00"
		displayFolder: Gráfico
		lineageTag: a0f79096-e848-55cd-9cc3-37f64caf9208

	measure 'Impostos na Semana' = ```
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR ref = [Semana de Referência]
			VAR s = MAX ( dim_semana[semana] )
			RETURN
			    IF ( s > ref - 364 && s <= ref, CALCULATE ( AVERAGE ( composicao_preco_semana[tributos_federais] ) + AVERAGE ( composicao_preco_semana[icms] ), REMOVEFILTERS ( dim_uf ), composicao_preco_semana[uf] = u ) )
			```
		formatString: """R$"" #,0.00"
		displayFolder: Gráfico
		lineageTag: f7588e23-2db9-5685-95e7-838364b5609c

	measure 'Outros na Semana' = ```
			VAR u = SELECTEDVALUE ( dim_uf[uf], "BR" )
			VAR ref = [Semana de Referência]
			VAR s = MAX ( dim_semana[semana] )
			RETURN
			    IF ( s > ref - 364 && s <= ref, CALCULATE ( AVERAGE ( composicao_preco_semana[outros] ), REMOVEFILTERS ( dim_uf ), composicao_preco_semana[uf] = u ) )
			```
		formatString: """R$"" #,0.00"
