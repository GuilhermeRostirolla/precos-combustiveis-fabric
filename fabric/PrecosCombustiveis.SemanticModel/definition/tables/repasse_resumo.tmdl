table repasse_resumo
	lineageTag: bd054155-45ed-5324-9e51-36b0093a82ed
	sourceLineageTag: [gold].[repasse_resumo]

	measure 'Repasse RS' = ```
			// soma das variações na bomba / soma dos repasses esperados, no estado
			CALCULATE ( MAX ( repasse_resumo[repasse_ponderado] ), repasse_resumo[escopo] = "RS (estado)" )
			```
		formatString: 0%
		displayFolder: Repasse
		lineageTag: 564e4b34-a98d-55d8-9345-336d3361bdbc

	measure 'Repasse Mediano RS' = CALCULATE ( MAX ( repasse_resumo[repasse_mediano] ), repasse_resumo[escopo] = "RS (estado)" )
		formatString: 0%
		displayFolder: Repasse
		lineageTag: 23183209-5e19-52a7-a293-33b2ec560fc2

	measure 'Reajustes Acompanhados' = CALCULATE ( MAX ( repasse_resumo[eventos] ), repasse_resumo[escopo] = "RS (estado)" )
		formatString: #,0
		displayFolder: Repasse
		lineageTag: 06bb6e60-5277-53f7-8791-2ebb09f6a3a9

	measure 'Repasse na Semana (alta)' = ```
			CALCULATE (
			    MAX ( repasse_resumo[repasse_ponderado] ),
			    repasse_resumo[escopo] = "RS (estado)",
			    repasse_resumo[direcao] = "alta",
			    repasse_resumo[h] = 0
			)
			```
		formatString: 0%
		displayFolder: Repasse
		lineageTag: 6192134c-e686-531f-8c7a-e1c8348dee07

